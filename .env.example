# Freearcs Pharma Services - Environment Variables
# Copy to .env and fill in values
# Vite automatically loads .env files

# === Application ===
# Enable health check endpoints (true/false)
ENABLE_HEALTH_CHECK=false

# === Analytics ===
# PostHog configuration (optional - see GDPR compliance plan)
# VITE_POSTHOG_KEY=phc_your_key_here
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# === API (when backend implemented) ===
# VITE_API_URL=https://api.freearcs-pharma.com

# === Feature Flags ===
# VITE_MAINTENANCE_MODE=false

# === Contact Pipeline (server-side only) ===
# Never prefix secrets with VITE_. VITE_* values are exposed to the browser.
# CONTACT_DELIVERY_MODE=resend
# CONTACT_TO_EMAIL=contact@freearcs.com
# CONTACT_FROM_EMAIL="Freearcs Website <website@your-verified-domain.example>"
# RESEND_API_KEY=re_xxxxxxxxx
#
# Alternative transport:
# CONTACT_DELIVERY_MODE=webhook
# CONTACT_WEBHOOK_URL=https://automation.example.com/freearcs-contact
# CONTACT_WEBHOOK_TOKEN=replace_me
#
# Optional origin allowlist (comma-separated). If omitted, same-host browser origins are accepted.
# CONTACT_ALLOWED_ORIGINS=https://www.example.com,https://example.com
#
# Contact rate limiting defaults: 5 submissions / 10 minutes.
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=600000
# CONTACT_DELIVERY_TIMEOUT_MS=8000
#
# Optional distributed rate limiting (recommended for production serverless deployments).
# Either Vercel KV-compatible or Upstash Redis REST variables may be used:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
